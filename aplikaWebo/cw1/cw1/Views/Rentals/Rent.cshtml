<div class="card shadow-sm p-4 mt-4 mx-auto" style="max-width: 500px;">
    <h3 class="mb-3">Wypożycz Rower</h3>
    <form asp-action="Rent" method="post">
        <input type="hidden" name="bikeId" value="@ViewBag.BikeId" />
        <div class="mb-3">
            <label class="fw-bold">Imię</label>
            <input type="text" name="firstName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="fw-bold">Nazwisko</label>
            <input type="text" name="lastName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="fw-bold">Telefon</label>
            <input type="text" name="phone" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success w-100">Biorę ten sprzęt</button>
    </form>
</div>