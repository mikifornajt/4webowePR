@model Bike

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Dodaj Nowy Rower</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nazwa roweru</label>
                        <input type="text" asp-for="Name" class="form-control" placeholder="np. Enduro Pro" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cena za dzień (zł)</label>
                        <input type="number" step="0.01" asp-for="PricePerDay" class="form-control" placeholder="100.00" required />
                    </div>
                    <div class="form-check mb-4">
                        <input type="checkbox" asp-for="IsAvailable" class="form-check-input" id="isAvailable" checked />
                        <label class="form-check-label" for="isAvailable">Rower jest od razu dostępny</label>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold">Zapisz w bazie</button>
                    <a href="/Bikes" class="btn btn-outline-secondary w-100 mt-2">Powrót do listy</a>
                </form>
            </div>
        </div>
    </div>
</div>