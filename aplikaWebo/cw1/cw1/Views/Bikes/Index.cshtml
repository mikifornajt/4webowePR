@model List<Bike>
    @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success fs-4 fw-bold text-center shadow-sm mb-4">
        ✅ @TempData["SuccessMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🚴 Dostępne Rowery</h2>
    <a href="/Bikes/Create" class="btn btn-primary fw-bold">+ Dodaj Nowy Rower</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nazwa Roweru</th>
                    <th>Cena za Dzień</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bike in Model)
                {
                    <tr>
                        <td>@bike.Id</td>
                        <td class="fw-bold">@bike.Name</td>
                        <td>@bike.PricePerDay.ToString("0.00") zł</td>
                        <td>
                          @if (bike.IsAvailable)
                                {
                                    <span class="badge bg-success mb-1">Dostępny</span><br/>
                                    <a href="/Rentals/Rent?bikeId=@bike.Id" class="btn btn-sm btn-outline-success">Wypożycz</a>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Wypożyczony</span>
                                }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>